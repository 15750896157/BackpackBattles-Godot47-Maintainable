[sub_resource type="Shader" id="151"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0);

void fragment(){
	vec4 texCol = texture(TEXTURE, UV);
	COLOR = texCol;
	//if (COLOR.r < 0.9){
	//COLOR.rgb *= smoothstep(progress-0.02, progress+0.02, 1.0-UV.x);
	float p = 1.0 - progress;
	COLOR.a *= smoothstep(p-0.01, p+0.01, 1.0-UV.x);
	
	
}"

