extends SceneTree

var checks = 0
var failures: Array = []
var evidence: Dictionary = {}
var db

func _init(): call_deferred("execute")

func check(value: bool, name: String):
	checks += 1
	if not value: failures.append(name); printerr("MIGRATION_FAIL ", name)

func execute():
	db = ContentDB.new()
	var base = OS.get_environment("PVE_MIGRATION_FIXTURE_DIR")
	if base.is_empty(): base = ProjectSettings.globalize_path("res://..").path_join("migration_saves")
	var manifest = JSON.parse_string(FileAccess.get_file_as_string(base.path_join("fixture_manifest.json")))
	check(manifest.ok and manifest.old_content_version == "0.1.2", "fixture was generated by actual 0.1.2 Flow and configuration")
	for kind in ["combat", "route"]:
		var saves = SaveService.new(base.path_join(kind))
		var loaded = saves.load_save("run")
		check(loaded.ok and loaded.data.content_sha256 == manifest.old_content_sha256, kind + " loads a checksum-verified real old save envelope")
		var flow = GameFlow.new(db, saves)
		var notifications: Array = []
		flow.notification.connect(func(key): notifications.append(key))
		var before = loaded.data
		var result = flow.continue_run()
		check(result.ok and flow.run.content_version == "0.1.3" and flow.run.content_sha256 == db.content_sha256, kind + " migrates content version and hash")
		check(flow.run.gold == before.gold and flow.run.health == before.health and flow.run.build == before.build, kind + " retains actual gold health and full item/bag coordinates")
		check(flow.run.logs == before.logs and flow.run.rng == before.rng, kind + " retains prior logs and RNG without committing or consuming combat")
		if kind == "combat":
			check(flow.screen_state == "SHOP_PREPARE" and flow.run.combat_checkpoint.is_empty() and flow.combat_result.is_empty(), "changed combat checkpoint rolls back safely to editable shop")
			check("content_changed_return_to_shop" in notifications, "combat rollback notifies player")
			# Tutorial progress belongs to profile; the old isolated campaign used
			# an in-memory profile. Persist the explicit skip through the public API.
			flow.skip_tutorial()
			var new_start = flow.start_combat()
			check(new_start.ok and flow.combat_result.get("ok", false) and flow.run.combat_checkpoint.get("player", {}).get("content_sha256", "") == db.content_sha256, "rolled-back real build starts a new valid current-content battle: " + str(new_start))
			if new_start.ok:
				var fresh = CombatEngine.new(db).simulate(flow.run.combat_checkpoint.player, flow.run.combat_checkpoint.enemy, int(flow.run.combat_checkpoint.seed))
				check(fresh.replay_digest == flow.combat_result.replay_digest, "new checkpoint exactly replays with the same saved seed")
			var persisted = saves.load_save("run")
			check(persisted.ok and persisted.data.state == "COMBAT_RUNNING" and persisted.data.content_version == "0.1.3", "new checkpoint is atomically persisted after restarting battle")
		else:
			check(flow.screen_state == "ROUTE_SELECT" and flow.run.route_candidates.size() >= 2, "route migration remains on route select with real alternatives")
			check(flow.run.route_candidates.all(func(card): return card.type not in ["event", "rest", "merchant"]), "stale route candidates are refreshed after chapter noncombat allowance was consumed")
			check("content_changed" in notifications, "route migration emits localized refresh notice")
			var bad = flow.encounters.make_card(flow.run, "rest", DeterministicRNG.new(1), int(flow.run.step))
			flow.run.route_candidates = [bad]
			var rejected = flow.choose_route(0)
			check(not rejected.ok and rejected.error == "route_no_longer_available", "stale direct-selection attempt is rejected without granting an extra rest")
			check(flow.screen_state == "ROUTE_SELECT" and flow.run.route_candidates.size() >= 2 and flow.run.health == before.health, "rejected stale selection refreshes choices without resource changes")
		evidence[kind] = {"original_state": before.state, "restored_state": "SHOP_PREPARE" if kind == "combat" else "ROUTE_SELECT", "original_health": before.health, "original_gold": before.gold, "original_build_sha256": JSON.stringify(before.build, "", true).sha256_text(), "notices": notifications, "new_checkpoint_seed": flow.run.combat_checkpoint.get("seed", -1), "replay_digest": flow.combat_result.get("replay_digest", "")}
	check(db.text("content_changed", "zh_CN") != "content_changed" and db.text("route_no_longer_available", "en") != "route_no_longer_available", "migration notices are available from source bilingual content")
	var report = {"ok": failures.is_empty(), "checks": checks, "failures": failures, "content_version": db.content_version, "content_sha256": db.content_sha256, "old_content_sha256": manifest.old_content_sha256, "evidence": evidence, "flow_sha256": FileAccess.get_file_as_string("res://PvE/Rules/app/GameFlow.gd").sha256_text()}
	var file = FileAccess.open("res://content_migration_tests.json", FileAccess.WRITE); file.store_string(JSON.stringify(report, "\t")); file.close()
	print("CONTENT_MIGRATION_TESTS ", JSON.stringify(report)); quit(0 if failures.is_empty() else 1)
