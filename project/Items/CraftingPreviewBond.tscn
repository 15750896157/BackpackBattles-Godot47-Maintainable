[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;
global uniform float bb_shader_time;

uniform float wobbliness : hint_range(0, 1) = 0.5;
uniform float centralityFactor : hint_range(0, 4) = 2.0;



uniform sampler2D gradient : repeat_disable, filter_linear;
uniform sampler2D thicknessCurve : repeat_disable, filter_linear;

uniform sampler2D NOISE_PATTERN : repeat_enable, filter_linear;
uniform sampler2D NOISE_PATTERN2 : repeat_enable, filter_linear;


uniform vec2 scroll1 = vec2(1 , 0.4);
uniform vec2 scroll2 = vec2(0.2, 1.2);
uniform float laserSize: hint_range(-1.0, 1.0) = 0.2;
uniform float yStretch = 0.1;
uniform float xStretch = 1.0;

void fragment() {
\tvec2 stretched_UV = UV;
\tstretched_UV.y *= yStretch;
\tstretched_UV.x *= xStretch;

\tfloat intensity1 = texture(NOISE_PATTERN, stretched_UV + bb_shader_time * scroll1).r;
\tfloat intensity2 = texture(NOISE_PATTERN2, stretched_UV + bb_shader_time * scroll2).r;
\tfloat thickness = texture(thicknessCurve, UV).r;
\tfloat intensity = (intensity1 * intensity2);
\t
\tfloat centrality = (1.0 - abs(UV.y - 0.5))* 0.5;
\tCOLOR = texture(gradient, vec2((intensity * wobbliness + centrality * centrality * centralityFactor + laserSize) * thickness));

}"

