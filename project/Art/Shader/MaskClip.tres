[sub_resource type="Shader" id="405"]
code = "shader_type canvas_item;

uniform sampler2D mask : repeat_disable, filter_linear;
uniform float xPosition : hint_range(-1.0, 1.0, 0.01) = 0.0;
uniform float scale = 1.0;

void fragment() {
	COLOR = texture(TEXTURE, UV);
	float maskAlpha = texture(mask, (SCREEN_UV + vec2(xPosition, 0.0))* vec2(scale, 1.0)).a;
	COLOR.a *= maskAlpha;
}
"

