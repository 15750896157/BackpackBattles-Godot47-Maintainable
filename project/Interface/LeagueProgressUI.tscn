[sub_resource type="Shader" id=153]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0);

void fragment(){
\tvec4 texCol = texture(TEXTURE, UV);
\tCOLOR = texCol;
\t//if (COLOR.r < 0.9){
\t//COLOR.rgb *= smoothstep(progress-0.02, progress+0.02, 1.0-UV.x);
\tfloat p = 1.0 - progress;
\tCOLOR.a *= smoothstep(p-0.01, p+0.01, 1.0-UV.x);
\t
\t
}"

