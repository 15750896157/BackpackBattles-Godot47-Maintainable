[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;
uniform sampler2D legacy_screen_texture : hint_screen_texture, repeat_disable, filter_linear;

uniform float refractionMagnitude = 3.0;
const vec2 refrectionVec =  vec2(-1.0, 1.0);
void fragment() {
\t
\t// Possibly a more acturate way to do refraction? Uncomment and see how you like it (and comment out below refraction)
\t//vec2 refraction = -refract(vec3(0,0,-1), texture(TEXTURE, UV).rgb, 1.1).xy;
\t//vec3 refraction = -refract(vec3(2,2,1), texture(TEXTURE, UV).rgb, 1.1);
\tvec4 textureRead = texture(TEXTURE, UV);
\t
\tvec2 refraction = (textureRead.xy - 0.5) * refrectionVec;
\t//float i= (COLOR.r + COLOR.g + COLOR.b)*3.0;
\tvec4 offsetScreenRead = texture(legacy_screen_texture, SCREEN_UV 
\t\t+ refraction * refractionMagnitude * textureRead.a);
\t
\tCOLOR = offsetScreenRead;
\t
\t
}"

