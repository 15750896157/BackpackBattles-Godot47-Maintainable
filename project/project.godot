[layer_names]

2d_physics/layer_1="Item"
2d_physics/layer_2="Socket"
2d_physics/layer_3="ItemTitle"
2d_physics/layer_4="GrabbableItem"

[logging]

file_logging/max_log_files=20

[network]

limits/debugger/max_chars_per_second=304800
limits/debugger/max_warnings_per_second=300

[physics]

common/enable_pause_aware_picking=true
2d/run_on_thread=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_environment="res://default_env.tres"
2d/options/ninepatch_mode=0

[shader_globals]

bb_shader_time={
"type": "float",
"value": 0.0
}
