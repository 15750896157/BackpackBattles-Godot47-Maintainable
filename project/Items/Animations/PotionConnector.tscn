[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;
global uniform float bb_shader_time;
varying vec4 legacy_modulate;

uniform float wobbliness : hint_range(0, 5) = 0.5;

uniform sampler2D gradient : repeat_disable, filter_linear;

uniform sampler2D NOISE_PATTERN : repeat_enable, filter_linear;
uniform sampler2D NOISE_PATTERN2 : repeat_enable, filter_linear;

uniform vec2 scroll1 = vec2(1 , 0.4);
uniform vec2 scroll2 = vec2(0.2, 1.2);

uniform float noise1Scale : hint_range(0.0, 10.0) = 1.0;
uniform float noise2Scale : hint_range(0.0, 10.0) = 1.0;

// legacy_modulate.a - revealFactor
// legacy_modulate.r - high modulate
// legacy_modulate.g - time offset

void fragment() {
\tCOLOR = vec4(1.0);
\tfloat adjustedTime = bb_shader_time * legacy_modulate.g;
\tfloat intensity1 = texture(NOISE_PATTERN, UV * noise1Scale + adjustedTime * scroll1).r;
\tfloat intensity2 = texture(NOISE_PATTERN2, UV * noise2Scale + adjustedTime * scroll2).r;
\tfloat intensity = (intensity1 * intensity2);
\tfloat texAlpha = texture(TEXTURE, UV).a;
\tCOLOR = texture(gradient, vec2(intensity * texAlpha * wobbliness * legacy_modulate.a));
\tCOLOR.rgb *= legacy_modulate.r;
}
void vertex() { legacy_modulate = COLOR; }
"

