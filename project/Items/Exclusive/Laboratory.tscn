[sub_resource type="Shader" id=12]
code = "shader_type canvas_item;

uniform vec2 direction = vec2(0.5, 0.5);
uniform float angle : hint_range(0.0, 6.5, 0.1);
uniform sampler2D gradient : repeat_disable, filter_linear;
uniform sampler2D bubbleNoise : repeat_enable, filter_linear;
uniform vec2 noiseScale = vec2(1,1);
uniform float foaminess = 0.2;
uniform vec2 foamOffset = vec2(0,0);
uniform float levelOffset : hint_range(-1.0, 1.0) = 0.0;
//uniform vec4 flashColor : source_color;
//uniform float flashState : hint_range(0.0, 1.0) = 0.0;
uniform float fade : hint_range(0.0, 1.0) = 0.0;
uniform sampler2D gradient2 : repeat_disable, filter_linear;

vec2 rotate(vec2 uv, vec2 pivot, float r)
{
\tmat2 rotation = mat2(vec2(sin(r), -cos(r)),
\t\t\t\t\t\tvec2(cos(r), sin(r)));
\t
\tuv -= pivot;
\tuv = uv * rotation;
\tuv += pivot;
\treturn uv;
}

void fragment()
{
\tvec2 rotated_uv = rotate(UV, vec2(0.5), angle);
\tCOLOR = texture(TEXTURE, UV);
//\tfloat dotPr = dot(direction, UV);
//\tif (dotPr < 1.0) {
//\t\tCOLOR.a = 0.0;
//\t}
\t//COORDINATE SPACE FOR FOAM OFFSET?
\t//COORDINATE SPACE FOR FOAM OFFSET?

\t//float bubbles = texture(bubbleNoise, rotated_uv * noiseScale + foamOffset).r;
\tfloat bubbles = texture(bubbleNoise, (SCREEN_UV- foamOffset) * noiseScale).r;
\t
\tfloat borderBonus = abs(rotated_uv.x - 0.5);
\tborderBonus = pow(borderBonus, 4) * 2.0;
\tvec2 gradCoord = rotated_uv.yy + bubbles * foaminess + borderBonus + levelOffset;
\tvec4 gr = texture(gradient, gradCoord);
\tif (fade > 0.0)
\t{
\t\tvec4 gr2 = texture(gradient2, gradCoord);
\t\tgr = mix(gr, gr2, fade);
\t}

\t//COLOR.rgb = mix(COLOR.rgb, gr.rgb, gr.a);
\tif (COLOR.a > 0.0)
\t\t//COLOR.a = 1.0;
\t\tCOLOR = gr;
\t
\t//if (flashState > 0.0)
\t//\tCOLOR.rgb = mix(COLOR.rgb, flashColor.rgb, flashState);
\t
\t//COLOR.rgb = mix(COLOR.rgb, vec3(1), foaminess);
\t//if (rotated_uv.y < 0.5) {COLOR.a = 0.0;}
\t//COLOR.a *= step(dotPr, 1.0);
}"

