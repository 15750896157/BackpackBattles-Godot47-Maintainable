[sub_resource type="Shader" id="455"]
code = "shader_type canvas_item;
global uniform float bb_shader_time;

uniform sampler2D gradient : repeat_disable, filter_linear;
uniform float speed : hint_range(0.1,10,0.01) = 1.0;
uniform float frequency : hint_range(0,100,0.01) = 1.0;
uniform float threshold : hint_range(0, 1, 0.01) = 0.3;
uniform float fade : hint_range(0, 4, 0.01) = 2;
uniform vec4 maskColor : source_color;

void fragment(){
	COLOR = texture(TEXTURE, UV);
	float difToMaskColor = maskColor.g - COLOR.g;
	if (difToMaskColor < threshold) {
		float ONE = 1.0;
		float offset = modf(UV.y * frequency + bb_shader_time * speed, ONE);
		float f = clamp((threshold - difToMaskColor) *fade, 0 , 1);
		//f = 1.0;
		vec3 gradientS = texture(gradient, vec2(offset)).rgb;
		//COLOR.rgb = gradientS * 1.6 * f;
		
		COLOR.rgb += gradientS;
		
	}
	
}"

