[sub_resource type="Shader" id=16]
code = "shader_type canvas_item;
global uniform float bb_shader_time;

uniform sampler2D tone_mapping : repeat_disable, filter_linear;

uniform sampler2D NOISE_PATTERN : repeat_enable, filter_linear;
uniform sampler2D NOISE_PATTERN2 : repeat_enable, filter_linear;
uniform vec2 scroll1 = vec2(1 , 0.4);
uniform vec2 scroll2 = vec2(0.2, 1.2);

uniform float baseIntensity : hint_range(0.0,0.5) = 0.1;
uniform float intensityFactor : hint_range(0.0,5.0) = 1.5;

uniform vec2 noise1Scale = vec2(1,1);
uniform vec2 noise2Scale = vec2(1,1);
uniform float blur : hint_range(0.0, 7.0) = 3.0;

uniform float staticFactor : hint_range(-1,1) = 0.5;

uniform float zoomLevel : hint_range(0.0, 10.0) = 1.;
uniform vec2 cen = vec2(0.5);

vec2 polar_coordinates(vec2 uv, vec2 center, float zoom, float repeat)
{
\tvec2 dir = uv - center;
\tfloat radius = length(dir) * 2.0;
\tfloat angle = atan(dir.y, dir.x) * 1.0/(3.1416 * 2.0);
\treturn mod(vec2(radius * zoom, angle * repeat), 1.0);
}

void fragment() {
\tvec2 polar_uv = polar_coordinates(UV.xy, cen, zoomLevel, 1.0);

\tvec4 texVal = textureLod(TEXTURE, UV, blur);
\tfloat texAlpha = texVal.a;
\t
\tfloat intensity1 = textureLod(NOISE_PATTERN, polar_uv * noise1Scale + bb_shader_time * scroll1, 0.0).r;
\tfloat intensity2 = textureLod(NOISE_PATTERN2, polar_uv * noise2Scale + bb_shader_time * scroll2, 0.0).r;
\tfloat intensity= ((intensity1 * intensity2) + baseIntensity+ texVal.r * staticFactor) * intensityFactor * texAlpha;
\t
\tCOLOR = textureLod(tone_mapping, vec2(intensity), 0.0);
}"

