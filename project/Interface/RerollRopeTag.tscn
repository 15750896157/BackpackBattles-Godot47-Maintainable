[sub_resource type="Shader" id=299]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 0.5;
uniform sampler2D overlayTexture : repeat_enable, filter_linear;
uniform sampler2D noise : repeat_enable, filter_linear;

void fragment() {
\tvec4 tex = texture(TEXTURE, UV);
\tvec4 overlay = texture(overlayTexture, UV);
\tfloat noiseVal = texture(noise, UV).r * 0.1;
\tif (progress + noiseVal >= UV.x)
\t\tCOLOR = overlay;
\telse
\t\tCOLOR = tex;
\t
}"

