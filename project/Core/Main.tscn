[sub_resource type="Shader" id="288"]
code = "shader_type canvas_item;
uniform sampler2D legacy_screen_texture : hint_screen_texture, repeat_disable, filter_linear;

uniform sampler2D overlayTexture : repeat_enable, filter_linear;

void fragment() {
	//vec4 overlayColor = texture(overlayTexture, UV);
	float screenBrightness = dot(texture(legacy_screen_texture, SCREEN_UV).rgb, vec3(0.33));
	vec4 texColor = textureLod(TEXTURE, UV, 0);
	COLOR.rgb = texColor.rgb * screenBrightness;
	COLOR.a = texColor.a;
	//COLOR.rgb += overlayColor.r * overlayColor.r * overlayColor.a;
	
}"

[sub_resource type="ShaderMaterial" id="289"]
shader = SubResource("288")
shader_parameter/overlayTexture = ExtResource("63")

