; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="背包"
run/main_scene="res://Code/Core/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="BackpackBattles_Local47_PvE"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/flush_stdout_on_print=true
run/low_processor_mode_sleep_usec=33000
boot_splash/image="res://Art/Reference20261102/boot.png"
config/icon="res://ClientIcon_256.png"
config/recovered_project=true
config/recovered_offline=false
config/local_services=true

[audio]

buses/default_bus_layout="uid://csuum7oc6bqgu"

[autoload]

ShaderClock="*res://Code/Compatibility/ShaderClock.gd"
FontSizeBinder="*res://Code/Compatibility/FontSizeBinder.gd"
LocalServices="*res://Code/LocalServices/LocalStore.gd"
Steam="*res://Code/LocalServices/LocalSteam.gd"
ControllerIcons="*res://addons/controller_icons/ControllerIcons.gd"
Util="*res://Code/Utility/Util.gd"
AssetStream="*res://Code/Runtime/Loading/AssetStream.gd"
SteamHelper="*res://Code/Utility/SteamHelper.gd"
Settings="*res://Code/Utility/Settings.gd"
InputMapping="*res://UI/Interface/Options/InputMapping.gd"
SilentWolf="*res://addons/silent_wolf/SilentWolf.gd"
ItemBook="*res://Data/Sheets/ItemBook.gd"
SkinBook="*res://Code/Utility/SkinBook.gd"
Game="*res://Code/Core/Game.gd"
ObjectPool="*res://Code/Utility/ObjectPool.gd"
RunDatabase="*res://Code/Core/RunDatabase.gd"
Sound="*res://Code/Utility/Sound.tscn"
CrazySDK="*res://Code/Utility/CrazySDK.gd"
CraftingManager="*res://Code/Core/CraftingManager.gd"
MaterialCompiler="*res://Code/Utility/MaterialCompiler.gd"
EventBus="*res://Code/Utility/EventBus.gd"
CustomRules="*res://Code/Utility/CustomRules.gd"
InputBlocker="*res://UI/Interface/InputBlocker.tscn"
Expedition="*res://PvE/NativeExpedition.gd"
SceneRouter="*res://Code/Runtime/Scene/SceneRouter.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/unused_signal=false
gdscript/warnings/integer_division=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/deprecated_keyword=false
gdscript/warnings/inference_on_variant=0
gdscript/warnings/native_method_override=0
shapes/collision/shape_color=Color(0.701961, 0.541176, 0, 0.419608)
gdscript/warnings/unused_argument=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://Art/Assets/Cursor/Cursor_default_small.png"
mouse_cursor/custom_image_hotspot=Vector2(20, 25)

[editor_plugins]

enabled=PackedStringArray()

