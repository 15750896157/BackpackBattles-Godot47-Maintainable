[sub_resource type="Shader" id=30]
code = "shader_type canvas_item;
global uniform float bb_shader_time;
render_mode blend_premul_alpha;

uniform float Line_Smoothness : hint_range(0, 0.1) = 0.045;
uniform float Line_Width : hint_range(0, 0.2) = 0.09;
uniform float Brightness = 3.0;
uniform float Rotation_deg : hint_range(-90, 90) = 30;
uniform float Distortion : hint_range(1, 2) = 1.8;
uniform float Speed = 0.7;
uniform float Position : hint_range(-1, 2) = 0;
uniform float Position_Min = 0.25;
uniform float Position_Max = 0.5;
uniform float Alpha : hint_range(0, 1) = 1;
uniform sampler2D surface : repeat_disable, filter_linear;

vec2 rotate_uv(vec2 uv, vec2 center, float rotation, bool use_degrees){
\t\tfloat _angle = rotation;
\t\tif(use_degrees){
\t\t\t_angle = rotation * (3.1415926/180.0);
\t\t}
\t\tmat2 _rotation = mat2(
\t\t\tvec2(cos(_angle), -sin(_angle)),
\t\t\tvec2(sin(_angle), cos(_angle))
\t\t);
\t\tvec2 _delta = uv - center;
\t\t_delta = _rotation * _delta;
\t\treturn _delta + center;
\t}

void fragment() {
\tvec2 center_uv = UV - vec2(0.5, 0.5);
\tfloat gradient_to_edge = max(abs(center_uv.x), abs(center_uv.y));
\tgradient_to_edge = gradient_to_edge * Distortion;
\tgradient_to_edge = 1.0 - gradient_to_edge;
\tvec2 rotaded_uv = rotate_uv(UV, vec2(0.5, 0.5), Rotation_deg, true);
\t
\tfloat remapped_position;
\t{
\t\tfloat output_range = Position_Max - Position_Min;
\t\tremapped_position = Position_Min + output_range * Position;
\t}
\t
\tfloat remapped_time = bb_shader_time * Speed + remapped_position;
\tremapped_time = fract(remapped_time);
\t{
\t\tremapped_time = -2.0 + 4.0 * remapped_time;
\t}
\t
\tvec2 offset_uv = vec2(rotaded_uv.xy) + vec2(remapped_time, 0.0);
\tfloat line = vec3(offset_uv, 0.0).x;
\tline = abs(line);
\tline = gradient_to_edge * line;
\tline = sqrt(line);
\t
\tfloat line_smoothness = clamp(Line_Smoothness, 0.001, 1.0);
\tfloat offset_plus = Line_Width + line_smoothness;
\tfloat offset_minus = Line_Width - line_smoothness;
\t
\tfloat remapped_line;
\t{
\t\tfloat input_range = offset_minus - offset_plus;
\t\tremapped_line = (line - offset_plus) / input_range;
\t}
\tremapped_line *= Brightness;
\tremapped_line = min(remapped_line, Alpha);
\t
\tvec4 surface_tex = texture(TEXTURE, UV);
\tCOLOR.rgba *= vec4(clamp(remapped_line * surface_tex.a, 0.0, 1.0));
\t
//\tvec4 surface_tex = texture(TEXTURE, UV);
//\tCOLOR = surface_tex;
//\tfloat glow = remapped_line * surface_tex.a;
//\t//COLOR.rgba *= vec4(remapped_line) * surface_tex.a;
//\tglow = clamp(glow, 0.0, 2.0);
//\tCOLOR.rgb += vec3(glow);
}
"

